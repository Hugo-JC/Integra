{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.dev/schemas/reference-observations.schema.json",
  "title": "Reference observations catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "policy": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://integra.dev/schemas/reference-observation.schema.json",
        "title": "Reference observation",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceId",
          "canonicalUrl",
          "observedAt",
          "evidenceType",
          "location",
          "observation",
          "transferablePrinciple",
          "adaptation",
          "limitations",
          "verificationStatus"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "canonicalUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "observedAt": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 calendar date. Time-of-day is not required when the inspection date is known but the exact time was not captured."
          },
          "evidenceType": {
            "enum": [
              "direct-observation",
              "official-documentation",
              "supplied-screenshot",
              "source-trace",
              "inference"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 2
          },
          "viewport": {
            "type": [
              "string",
              "null"
            ]
          },
          "productState": {
            "type": [
              "string",
              "null"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 20
          },
          "transferablePrinciple": {
            "type": "string",
            "minLength": 20
          },
          "adaptation": {
            "type": "string",
            "minLength": 20
          },
          "doNotCopy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "verificationStatus": {
            "enum": [
              "verified",
              "partial"
            ]
          },
          "reviewedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
