{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.dev/schemas/asset-source.schema.json",
  "title": "Asset provider source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "url",
    "assetTypes",
    "bestFor",
    "discovery",
    "licensingPolicy",
    "attributionPolicy",
    "apiStatus",
    "perAssetVerificationRequired",
    "restrictions",
    "verificationStatus"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "assetTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "bestFor": {
      "type": "string",
      "minLength": 10
    },
    "discovery": {
      "type": "string",
      "minLength": 10
    },
    "licensingPolicy": {
      "type": "string",
      "minLength": 15
    },
    "attributionPolicy": {
      "type": "string",
      "minLength": 10
    },
    "apiStatus": {
      "enum": [
        "available",
        "not-assessed",
        "unavailable",
        "requires-approval"
      ]
    },
    "perAssetVerificationRequired": {
      "const": true
    },
    "restrictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verificationStatus": {
      "enum": [
        "catalog-only",
        "verified",
        "stale",
        "deprecated"
      ]
    }
  }
}
