{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.dev/schemas/asset-sources.schema.json",
  "title": "Asset providers catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy",
    "providers"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "policy": {
      "type": "string"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://integra.dev/schemas/asset-source.schema.json"
      }
    }
  }
}
