{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.dev/schemas/visual-source.schema.json",
  "title": "Visual source entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "url",
    "category",
    "bestFor",
    "howItWorks",
    "useWhen",
    "limitations",
    "tags",
    "verificationStatus",
    "lastVerifiedAt",
    "verifiedPage",
    "licenseNote"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "category": {
      "type": "string"
    },
    "bestFor": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "howItWorks": {
      "type": "string",
      "minLength": 20
    },
    "useWhen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verificationStatus": {
      "enum": [
        "catalog-only",
        "verified",
        "stale",
        "deprecated"
      ]
    },
    "lastVerifiedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "verifiedPage": {
      "type": [
        "string",
        "null"
      ]
    },
    "licenseNote": {
      "type": "string",
      "minLength": 10
    }
  }
}
