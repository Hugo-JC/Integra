{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.dev/schemas/token-system.schema.json",
  "title": "Token system recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "role",
    "modes",
    "contexts",
    "tags",
    "status",
    "contrastStatus",
    "tokens",
    "useWhen",
    "avoidWhen",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "minLength": 5
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "persuade",
          "operate",
          "read",
          "experience"
        ]
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "starter-recipe",
        "experimental",
        "deprecated"
      ]
    },
    "contrastStatus": {
      "enum": [
        "requires-rendered-verification",
        "partially-verified",
        "verified"
      ]
    },
    "tokens": {
      "type": "object",
      "required": [
        "colors",
        "typography",
        "spacing",
        "radius",
        "grid",
        "elevation",
        "motion"
      ],
      "properties": {
        "colors": {
          "type": "object",
          "minProperties": 5
        },
        "typography": {
          "type": "object"
        },
        "spacing": {
          "type": "object"
        },
        "radius": {
          "type": "object"
        },
        "grid": {
          "type": "object"
        },
        "elevation": {
          "type": "object"
        },
        "motion": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "useWhen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "avoidWhen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
