{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.dev/schemas/design-preset.schema.json",
  "title": "Integra contextual design preset",
  "type": "object",
  "required": ["id", "name", "version", "productContexts", "designIntent", "visualDirection", "layout", "components", "accessibility", "antiPatterns", "references"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 2 },
    "version": { "type": "string" },
    "productContexts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "designIntent": { "type": "object" },
    "visualDirection": { "type": "object" },
    "layout": { "type": "object" },
    "components": { "type": "object" },
    "accessibility": { "type": "object" },
    "antiPatterns": { "type": "array", "items": { "type": "string" } },
    "references": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
