{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.dev/schemas/design-preset.schema.json",
  "title": "Integra contextual design preset",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "productContexts",
    "designIntent",
    "visualDirection",
    "layout",
    "components",
    "accessibility",
    "antiPatterns",
    "references",
    "aiGuidance",
    "compositionEscapes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "productContexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "designIntent": {
      "type": "object",
      "required": [
        "primaryGoal",
        "audienceNeeds",
        "personalityAxes",
        "visualThesis"
      ],
      "properties": {
        "primaryGoal": {
          "type": "string",
          "minLength": 20
        },
        "audienceNeeds": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "personalityAxes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "visualThesis": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": true
    },
    "visualDirection": {
      "type": "object",
      "required": [
        "density",
        "surfaces",
        "colorIntent",
        "typography",
        "motion"
      ],
      "properties": {
        "density": {
          "type": "string",
          "minLength": 2
        },
        "surfaces": {
          "type": "string",
          "minLength": 10
        },
        "colorIntent": {
          "type": "string",
          "minLength": 10
        },
        "typography": {
          "type": "string",
          "minLength": 10
        },
        "motion": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "required": [
        "pattern",
        "spacing",
        "responsive",
        "contentPriority"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 10
        },
        "spacing": {
          "type": "string",
          "minLength": 5
        },
        "responsive": {
          "type": "string",
          "minLength": 10
        },
        "contentPriority": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "components": {
      "type": "object",
      "required": [
        "preferred",
        "states",
        "avoid"
      ],
      "properties": {
        "preferred": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "states": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "avoid": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "accessibility": {
      "type": "object",
      "required": [
        "minimumTextContrast",
        "keyboard",
        "focus",
        "reducedMotion"
      ],
      "properties": {
        "minimumTextContrast": {
          "type": "string",
          "minLength": 4
        },
        "keyboard": {
          "type": "string",
          "minLength": 10
        },
        "focus": {
          "type": "string",
          "minLength": 10
        },
        "reducedMotion": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": true
    },
    "antiPatterns": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aiGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryFlow",
        "prioritize",
        "confirmOrMarkUnknown",
        "avoidByDefault",
        "acceptanceChecks"
      ],
      "properties": {
        "primaryFlow": {
          "type": "string",
          "minLength": 30
        },
        "prioritize": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "confirmOrMarkUnknown": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "avoidByDefault": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "acceptanceChecks": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "compositionEscapes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "composition",
          "contentRequirements",
          "avoid"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "when": {
            "type": "string",
            "minLength": 25
          },
          "composition": {
            "type": "string",
            "minLength": 40
          },
          "contentRequirements": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "avoid": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 8
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
