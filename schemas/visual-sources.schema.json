{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.dev/schemas/visual-sources.schema.json",
  "title": "Visual sources catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "policy",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "policy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "https://integra.dev/schemas/visual-source.schema.json"
      }
    }
  }
}
