{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.dev/schemas/design-rule.schema.json",
  "title": "Design rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "force",
    "appliesWhen",
    "statement",
    "trigger",
    "rationale",
    "recommendedAction",
    "exceptions",
    "verification",
    "references",
    "provenance",
    "heuristic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "force": {
      "enum": [
        "required",
        "recommended",
        "contextual",
        "anti-pattern"
      ]
    },
    "appliesWhen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "all",
              "persuade",
              "operate",
              "read",
              "experience"
            ]
          }
        }
      }
    },
    "statement": {
      "type": "string",
      "minLength": 15
    },
    "trigger": {
      "type": "string",
      "minLength": 8
    },
    "rationale": {
      "type": "string",
      "minLength": 8
    },
    "recommendedAction": {
      "type": "string",
      "minLength": 8
    },
    "exceptions": {
      "type": "string",
      "minLength": 5
    },
    "verification": {
      "type": "object",
      "required": [
        "method",
        "requiredEvidence",
        "status"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "requiredEvidence": {
          "type": "string"
        },
        "status": {
          "enum": [
            "not-run",
            "partial",
            "passed",
            "failed",
            "inconclusive"
          ]
        }
      },
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heuristic": {
      "const": true
    }
  }
}
