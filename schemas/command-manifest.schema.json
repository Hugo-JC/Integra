{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.dev/schemas/command-manifest.schema.json",
  "title": "Integra Command Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "description", "invocation", "executionPolicy", "commands"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 20 },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "namespace", "bareAliases"],
      "properties": {
        "orchestrator": { "const": "/integra" },
        "namespace": { "const": "/integra:" },
        "bareAliases": { "enum": ["optional-host-adapter-only"] }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultMode", "sourceMutation", "previewMutation", "approvalScope", "neverInferApprovalFrom"],
      "properties": {
        "defaultMode": { "const": "review" },
        "sourceMutation": { "const": "approval-required" },
        "previewMutation": { "const": "temporary-dom-only" },
        "approvalScope": { "const": "exact-proposed-diff" },
        "neverInferApprovalFrom": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["command invocation", "preview acceptance", "generated patch", "test success"] }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "invocation", "description", "skills", "outputs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "kind": { "enum": ["orchestrator", "workflow", "modifier"] },
          "invocation": { "type": "string", "pattern": "^/integra(?::[a-z][a-z0-9-]*)?$" },
          "description": { "type": "string", "minLength": 30 },
          "skills": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
          "outputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
          "sourceMutation": { "enum": ["approval-required", "never"] }
        }
      }
    }
  }
}