{
  "name": "integra",
  "version": "0.2.0",
  "private": true,
  "description": "Integra AI Design Engine v5 — contextual design direction, portable agent skills, local preset discovery, live DOM inspection and evidence-led QA",
  "type": "module",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=10"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts",
    "validate:skills": "tsx scripts/validate-skills.ts",
    "validate:presets": "tsx scripts/validate-presets.ts",
    "direction:generate": "tsx scripts/direction-generate.ts",
    "direction:validate": "tsx scripts/direction-validate.ts",
    "check": "npm run typecheck && npm test && npm run validate:fixtures && npm run validate:agent-assets && npm run validate:commands",
    "direction:presets": "tsx scripts/direction-presets.ts",
    "validate:agent-assets": "tsx scripts/validate-agent-assets.ts",
    "validate:commands": "tsx scripts/validate-command-manifest.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
